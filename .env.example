# PostgreSQL on Neon, connected through the Vercel Marketplace.
# `vercel env pull .env.local` brings both values; tsx scripts read .env.local.
DATABASE_URL=
# Direct (non-pooled) connection, used by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=
# Must match the origin opened in the browser (including port). Also used as
# the public address in the sitemap, robots.txt and share previews.
BETTER_AUTH_URL=http://localhost:3000
# Required on Vercel. Locally, an absent value creates a private
# .data/auth-secret automatically.
BETTER_AUTH_SECRET=
# Inserts fictitious startups. Only against a separate database, never the
# production one (it is ignored on Vercel production).
LINKUP_SEED_DEMO=false
# Resend API key. With it, people can sign in with a 6-digit email code and
# every account confirms its email. Without it, nothing is sent.
RESEND_API_KEY=
# Sender address. Until a domain is verified in Resend, leave it empty: the
# default onboarding@resend.dev only delivers to the Resend account's owner.
LINKUP_EMAIL_FROM=
