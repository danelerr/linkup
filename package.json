{
  "name": "linkup",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "admin": "tsx scripts/admin.ts",
    "alerts": "tsx scripts/alerts.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "better-auth": "1.7.6",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "0.45.2",
    "lucide": "1.48.0",
    "lucide-react": "1.48.0",
    "morphicons": "1.7.1",
    "next": "16.3.6",
    "papaparse": "^5.5.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.19.19",
    "@types/papaparse": "^5.3.16",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "type": "module"
}
